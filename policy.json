{
  "version": "predicate-chess-policy/v1",
  "name": "forcing-clamp-1",
  "description": "Predicate Chess: observe first, generate only predicate-using forcing moves, prove every legal opponent reply, and stop at the declared tactical boundary.",
  "profile": {
    "see_after": 1,
    "try_budget": 10,
    "check_horizon": 2,
    "forcing_reply_probe": 1,
    "quiet_budget": 0,
    "repair_budget": 0,
    "behind_quiet_budget": 0,
    "gain_goal": "minor_piece"
  },
  "objective": {
    "mate_always_succeeds": true,
    "default_material_delta_pawns": 3,
    "settlement": "after_forcing_replies"
  },
  "proof": {
    "our_nodes": "exists",
    "opponent_nodes": "forall_legal",
    "reply_mode": "exhaustive",
    "unclassified_reply": "live",
    "first_refutation_stops_our_candidate": true,
    "stop_immediately_at_proved": true
  },
  "thought_states": [
    {
      "id": "OBSERVE",
      "meaning": "List relevant current-position predicates before generating a move."
    },
    {
      "id": "THREAT",
      "meaning": "Choose a forcing move that explicitly USES observed predicates."
    },
    {
      "id": "REPLIES",
      "meaning": "Represent every legal opponent reply; close it by a named rule or TRY it."
    },
    {
      "id": "CASH",
      "meaning": "Convert an already visible loose, forked, skewered, pinned, trapped, promoting, or mating target."
    },
    {
      "id": "COMPARE",
      "meaning": "Compare visible capture orders through the strongest live reply."
    },
    {
      "id": "FIX",
      "meaning": "Cure one named defect in an otherwise successful idea; disabled because repair_budget is zero."
    },
    {
      "id": "PROVED",
      "meaning": "The declared objective is proved inside the forcing clamp."
    },
    {
      "id": "HORIZON",
      "meaning": "The policy cannot visualize a new theme beyond its check or one-ply horizon."
    },
    {
      "id": "GIVEUP",
      "meaning": "No policy-permitted forcing continuation remains."
    }
  ],
  "candidate_selection": {
    "instruction": "Choose the first nonempty group. Within that group prefer fewer legal reply classes; then keep deterministic move order.",
    "groups": [
      {
        "id": "mate",
        "condition": "after(move).mate"
      },
      {
        "id": "single_reply_check",
        "condition": "after(move).check and after(move).legal_reply_classes == 1"
      },
      {
        "id": "objective_capture",
        "condition": "after(move).capture reaches the declared objective"
      },
      {
        "id": "check_most_uses",
        "condition": "after(move).check",
        "prefer": "most USES"
      },
      {
        "id": "forcing_most_uses",
        "condition": "move is forcing",
        "prefer": "most USES"
      }
    ]
  },
  "forcing_move_kinds": [
    "check",
    "capture",
    "mate_in_1_threat",
    "promotion_threat",
    "attack_queen",
    "attack_loose_piece",
    "attack_defender",
    "pin_defender",
    "remove_defender",
    "fork",
    "skewer",
    "line_opening"
  ],
  "reply_order": [
    "check",
    "capture_attacker_or_winning_piece",
    "save_or_continue_defending_target",
    "mate_in_1_threat",
    "equal_or_greater_material_counterthreat",
    "remaining_live_reply"
  ],
  "rules": [
    {
      "id": "SEE-FIRST",
      "text": "Do not generate or order candidates before SAW. Every candidate must name at least one observed predicate in USES."
    },
    {
      "id": "PICK-OUR-MOVE",
      "text": "Choose the first nonempty candidate group: mate; single-reply check; objective capture; check with most USES; other forcing move with most USES."
    },
    {
      "id": "ALL-REPLIES",
      "text": "After our TRY, every legal opponent move is represented by REPLY. Every reply not closed by a named rule is LIVE and must be TRYed."
    },
    {
      "id": "TRY-REPLIES",
      "text": "Try live checks first, then captures of the attacker, then target-preserving defenses, mate threats, equal counterthreats, and remaining live replies."
    },
    {
      "id": "FIRST-REFUTATION-STOPS",
      "text": "One live opponent reply that defeats our candidate refutes that candidate."
    },
    {
      "id": "REPLY-CLASS",
      "text": "Group legal replies only when every member has the same predicates, closure rule, and witness shape. Classes must be disjoint and exhaustive."
    },
    {
      "id": "CAPTURE-ORDER",
      "text": "When two related captures are visible, compare each through the opponent's strongest live reply and reject an order after its first refutation."
    },
    {
      "id": "HORIZON",
      "text": "After check_horizon own checks, begin no new tactical theme. Permit only required check answers, mate, CASH, or COMPARE."
    },
    {
      "id": "URGENCY",
      "text": "When behind material, every own move must check, threaten mate, win material, or directly attack a named target."
    },
    {
      "id": "CASH-SAFETY",
      "text": "After reaching the objective, one direct conversion move may save the winning piece, finish a forced trade, answer an attack on the gain, or place a threatened queen safely."
    }
  ],
  "closure_rules": [
    {
      "id": "CLOSE-MATE-IN-ONE",
      "requires": "a named mate-in-one witness in the reply position"
    },
    {
      "id": "CLOSE-ABANDON",
      "requires": "the reply abandons a bound target and a named immediate capture reaches the objective after one forcing probe"
    },
    {
      "id": "CLOSE-ONE-PLY-TACTIC",
      "requires": "a named one-ply check, capture, fork, skewer, pin conversion, or mate threat reaches the objective after one forcing probe"
    },
    {
      "id": "CLOSE-WIN-WITH-CHECK",
      "requires": "the witness captures the target with check and no legal check answer restores the material"
    },
    {
      "id": "CLOSE-RECAPTURE",
      "requires": "an immediate named recapture restores the objective"
    },
    {
      "id": "CLOSE-GAIN-CLAMP",
      "requires": "the goal is reached and the reply gives no check, mate-in-one threat, capture of the winning piece, equal-or-greater material win, or immediate promotion threat"
    },
    {
      "id": "CLOSE-PROMOTION",
      "requires": "a named passed-pawn sequence promotes or forces a rook/minor sacrifice, with no forcing countercheck or equal promotion"
    },
    {
      "id": "CLOSE-FORCED-TRADE",
      "requires": "an immediate named exchange sequence reaches the objective and no forcing intermezzo changes it"
    }
  ],
  "predicates": [
    {
      "id": "check",
      "signature": "check(move)",
      "source": "legal_moves"
    },
    {
      "id": "mate_in_1",
