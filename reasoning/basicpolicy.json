{
  "schema": "predicate-policy/v2",
  "name": "basic",
  "entry": "START",
  "outcomes": {
    "accept_state": "SOLVED",
    "reject_state": "EXHAUSTED",
    "winning_predicates": [
      "mate",
      "objective_won"
    ],
    "failure_predicates": []
  },
  "budgets": {
    "thoughts": 1600,
    "depth": 10,
    "call_depth": 0
  },
  "routines": [
    {
      "id": "main",
      "label": "Basic alternating pushdown search",
      "entry": "START"
    }
  ],
  "states": [
    {
      "id": "START",
      "routine": "main",
      "kind": "push_initial",
      "description": "Push the root position onto the position stack.",
      "on": {
        "pushed": "POP_POSITION",
        "invalid": "EXHAUSTED"
      }
    },
    {
      "id": "POP_POSITION",
      "routine": "main",
      "kind": "pop",
      "description": "Pop the next retained position from the LIFO stack.",
      "on": {
        "thought": "INSPECT_POSITION",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "INSPECT_POSITION",
      "routine": "main",
      "kind": "inspect",
      "terminal_checks": true,
      "description": "Accept a proven objective, close a dead line, or transition to the card for the side to move.",
      "rules": [
        {
          "label": "close this line and pop the next position",
          "when": {
            "any": [
              "mated",
              "stalemate",
              "unexplorable",
              "oracle_limit"
            ]
          },
          "to": "POP_POSITION"
        },
        {
          "label": "our move",
          "when": {
            "side": "my"
          },
          "to": "SEARCH_OUR_MOVE"
        },
        {
          "label": "opponent move",
          "when": {
            "side": "their"
          },
          "to": "SEARCH_OPPONENT_MOVE"
        }
      ],
      "on": {
        "depth": "POP_POSITION",
        "missing": "EXHAUSTED"
      },
      "default": "POP_POSITION"
    },
    {
      "id": "SEARCH_OUR_MOVE",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "description": "Check forced replies first when the legal move set is already bounded; otherwise check mate, mate in one, checks, captures, and attacks. Push at most two positions total.",
      "predicates": [
        "forced_reply",
        "mate",
        "mate_in_1",
        "check",
        "capture",
        "attack"
      ],
      "closure": {
        "mode": "first",
        "count": 2
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "POP_POSITION"
      }
    },
    {
      "id": "SEARCH_OPPONENT_MOVE",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "description": "Enumerate a bounded forced reply set first; otherwise check mate, mate in one, checks, captures, attacks, and a move that saves the attacked piece. Push at most two positions total.",
      "predicates": [
        "forced_reply",
        "mated",
        "mate_in_1",
        "check",
        "capture",
        "attack",
        "save_piece"
      ],
      "closure": {
        "mode": "first",
        "count": 2
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "POP_POSITION"
      }
    },
    {
      "id": "SOLVED",
      "routine": "main",
      "kind": "accept",
      "description": "Mate or a quiet two-pawn material objective was reached."
    },
    {
      "id": "EXHAUSTED",
      "routine": "main",
      "kind": "reject",
      "description": "The position stack emptied without reaching the objective."
    }
  ],
  "oracle": {
    "reply_limit": 2,
    "objective_gain": 2,
    "max_positions": 12000,
    "mate_probe": true,
    "mate_probe_limit": 96,
    "attack_min_value": 1
  }
}
