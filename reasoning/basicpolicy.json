{
  "schema": "predicate-policy/v2",
  "name": "basic",
  "version": "5.7.0",
  "goal": "gain_at_least_exchange",
  "test_file": "/reasoning/basicpolicy.test",
  "entry": "START",
  "outcomes": {
    "accept_state": "SOLVED",
    "reject_state": "EXHAUSTED",
    "winning_predicates": [
      "mate"
    ],
    "failure_predicates": []
  },
  "budgets": {
    "thoughts": 1600,
    "depth": 48,
    "call_depth": 0
  },
  "routines": [
    {
      "id": "main",
      "label": "Basic human chess DFA",
      "entry": "START"
    }
  ],
  "states": [
    {
      "id": "START",
      "routine": "main",
      "kind": "push_initial",
      "label": "Start",
      "description": "Push the root board position.",
      "on": {
        "pushed": "POP_POSITION",
        "invalid": "EXHAUSTED"
      }
    },
    {
      "id": "POP_POSITION",
      "routine": "main",
      "kind": "pop",
      "label": "Pop next position",
      "description": "Pop the highest-priority retained board position. A delimiter marks where the current batch ends.",
      "on": {
        "thought": "INSPECT_POSITION",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "INSPECT_POSITION",
      "routine": "main",
      "kind": "inspect",
      "label": "Inspect position",
      "terminal_checks": false,
      "description": "Choose the next card from ordinary chess facts visible in the current position.",
      "rules": [
        {
          "label": "we gave mate",
          "when": {
            "any": [
              "mate"
            ]
          },
          "to": "LINE_PROVED"
        },
        {
          "label": "the visible queen-rook edge mating net is established",
          "when": {
            "any": [
              "queen_rook_edge_mate_net"
            ]
          },
          "to": "LINE_PROVED"
        },
        {
          "label": "the displayed mate-threat refutation survives the opponent reply and keeps the material objective",
          "when": {
            "any": [
              "mate_threat_refutation_survived"
            ]
          },
          "to": "LINE_PROVED"
        },
        {
          "label": "we are mated or stalemated",
          "when": {
            "any": [
              "mated",
              "stalemate"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "the mate-threat reply card could not classify this opponent reply",
          "when": {
            "any": [
              "unclassified_mate_threat_reply"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "an opponent recapture erased the material objective with no bound continuation",
          "when": {
            "all": [
              "recapture"
            ],
            "none": [
              "up_material",
              "mate_available",
              "winning_recapture_available",
              "skewer_available",
              "capture_back_of_alignment_available",
              "alignment_back_piece_exposed",
              "alignment_capture_chain",
              "defender_of_loose_piece_is_attacked",
              "attacked_piece",
              "skewer",
              "mate_threat_followup_capture_ready",
              "mate_threat_interposer_was_recaptured"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "we answered a check and remain up the material objective",
          "when": {
            "all": [
              "check_response",
              "up_material"
            ]
          },
          "to": "LINE_PROVED"
        },
        {
          "label": "the two-ply check extension ended without preserving the material objective",
          "when": {
            "any": [
              "check_response"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "our king is in check",
          "when": {
            "side": "my",
            "any": [
              "in_check"
            ]
          },
          "to": "SEARCH_CHECK_RESPONSES"
        },
        {
          "label": "play the first forcing move of the visible queen-rook edge mating net",
          "when": {
            "side": "my",
            "any": [
              "mate_threat_edge_net_ready"
            ]
          },
          "to": "SEARCH_MATE_THREAT_CONTINUATION"
        },
        {
          "label": "continue after a mate-threat interposition",
          "when": {
            "side": "my",
            "any": [
              "mate_threat_interposer_ready_to_capture",
              "mate_threat_followup_capture_ready"
            ]
          },
          "to": "SEARCH_MATE_THREAT_CONTINUATION"
        },
        {
          "label": "continue the visible alignment capture chain",
          "when": {
            "side": "my",
            "any": [
              "alignment_capture_chain"
            ]
          },
          "to": "SEARCH_ALIGNMENT_CAPTURE_CHAIN"
        },
        {
          "label": "cash an exposed back piece in the alignment",
          "when": {
            "side": "my",
            "any": [
              "alignment_back_piece_exposed"
            ]
          },
          "to": "SEARCH_ALIGNMENT_CAPTURE_CHAIN"
        },
        {
          "label": "our move",
          "when": {
            "side": "my"
          },
          "to": "SEARCH_OUR_MOVE"
        },
        {
          "label": "the defender of a loose piece is attacked",
          "when": {
            "side": "their",
            "any": [
              "defender_of_loose_piece_is_attacked"
            ]
          },
          "to": "SEARCH_REPLIES_TO_ATTACKED_DEFENDER"
        },
        {
          "label": "the opponent must answer our visible mate-in-one threat",
          "when": {
            "side": "their",
            "any": [
              "threaten_mate_in_1"
            ]
          },
          "to": "SEARCH_REPLIES_TO_MATE_THREAT"
        },
        {
          "label": "the opponent may recapture or check after we captured the mate-threat interposer",
          "when": {
            "side": "their",
            "any": [
              "mate_threat_interposer_captured"
            ]
          },
          "to": "SEARCH_REPLIES_AFTER_MATE_INTERPOSER_CAPTURE"
        },
        {
          "label": "more than two relevant replies remain after the current human reply card",
          "when": {
            "side": "their",
            "any": [
              "more_than_two_relevant_replies"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "we are up the material objective",
          "when": {
            "side": "their",
            "any": [
              "up_material"
            ]
          },
          "to": "SEARCH_WHEN_UP_MATERIAL"
        },
        {
          "label": "the opponent has two or fewer legal moves",
          "when": {
            "side": "their",
            "any": [
              "two_or_fewer_legal_moves"
            ]
          },
          "to": "SEARCH_ALL_REPLIES"
        },
        {
          "label": "the current position contains a skewer",
          "when": {
            "side": "their",
            "any": [
              "skewer"
            ]
          },
          "to": "SEARCH_REPLIES_TO_SKEWER"
        },
        {
          "label": "the current position contains an attacked or loose piece",
          "when": {
            "side": "their",
            "any": [
              "attacked_piece",
              "loose_piece"
            ]
          },
          "to": "SEARCH_REPLIES_TO_ATTACKED_PIECE"
        },
        {
          "label": "this basic policy cannot narrow the opponent's replies",
          "when": {
            "side": "their"
          },
          "to": "LINE_FAILED"
        }
      ],
      "on": {
        "depth": "LINE_FAILED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "SEARCH_OUR_MOVE",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "label": "Our move",
      "description": "Scan one human chess list in order and push every matching legal move. After mate: checks with one reply, a visible mate-in-one threat, checks with two replies, then capture an undefended non-pawn before broader checks and captures.",
      "predicates": [
        "mate",
        "check_with_one_reply",
        "threaten_mate_in_1",
        "check_with_two_replies",
        "capture_undefended_non_pawn_piece",
        "move_middle_with_check",
        "check_and_attack_piece",
        "skewer",
        "check",
        "capture_back_of_alignment",
        "recapture",
        "capture_defender_of_alignment_target",
        "capture",
        "safely_add_attacker_to_defender_of_loose_piece",
        "add_attacker_to_loose_non_pawn_piece",
        "add_attacker_to_pinned_piece"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "choice",
        "on_empty": "LINE_FAILED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_ALIGNMENT_CAPTURE_CHAIN",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "label": "Alignment capture chain",
      "description": "A slider, an enemy middle piece, and an enemy back piece are aligned; the middle piece also defends another piece. This temporary card cashes the already-observed relation before starting unrelated checks: capture the defended alignment target, then capture the exposed back piece if the middle piece leaves the line.",
      "predicates": [
        "mate",
        "capture_alignment_target",
        "capture_back_of_alignment",
        "recapture",
        "check_with_one_reply",
        "check_with_two_replies",
        "check",
        "capture_undefended_non_pawn_piece",
        "capture",
        "safely_add_attacker_to_defender_of_loose_piece",
        "add_attacker_to_loose_non_pawn_piece",
        "add_attacker_to_pinned_piece"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "choice",
        "on_empty": "LINE_FAILED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_MATE_THREAT_CONTINUATION",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "label": "Continue after the mate-threat interposition",
      "description": "After a mate-threat defense interposes a piece, continue with the forcing move or capture that refutes that specific defense. This remains our choice card: the first fully proved continuation wins.",
      "predicates": [
        "mate",
        "queen_rook_edge_mate_net",
        "capture_mate_threat_interposer",
        "capture_undefended_non_pawn_piece"
      ],
      "closure": {
        "mode": "first",
        "count": 1
      },
      "frame": {
        "kind": "choice",
        "on_empty": "LINE_FAILED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_REPLIES_AFTER_MATE_INTERPOSER_CAPTURE",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Live replies after capturing the interposer",
      "description": "We have captured the mate-threat interposer and banked the material objective. Push every recapture that keeps the queen safe and every countercheck without a material-preserving immediate answer. Closed recaptures and checks remain in the oracle facts but are not live reply obligations.",
      "predicates": [
        "mated",
        "safe_recapture",
        "countercheck_survives"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "SEARCH_REPLIES_TO_MATE_THREAT",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "All replies to mate in one",
      "description": "Our previous move created a visible mate-in-one threat. Explore every immediate opponent move that matches an agreed human defense predicate\u2014even a bad defense. Nonmatching moves are closed because they do not answer the threat; matching moves are universal reply obligations and must be refuted on the board.",
      "predicates": [
        "mated",
        "check_with_one_reply",
        "check_with_two_replies",
        "check",
        "capture_mate_threat_piece",
        "capture_mate_threat_supporter",
        "interpose_mate_threat_battery",
        "add_defender_to_mating_square",
        "move_mating_target",
        "king_move",
        "unclassified_mate_threat_reply"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "SEARCH_CHECK_RESPONSES",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "label": "Answer the check",
      "description": "A check earns a two-ply extension: the checking move and one answer. Prefer mate, recapture, capture, then checks ordered by one reply, two replies, and other checks, then any legal king response.",
      "predicates": [
        "mate",
        "recapture",
        "capture",
        "check_with_one_reply",
        "check_with_two_replies",
        "check",
        "king_move",
        "legal_move"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "choice",
        "on_empty": "LINE_FAILED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_ALL_REPLIES",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "All replies",
      "description": "The opponent has at most two legal moves, so examine both. Captures and checks are ordered first; checks with fewer legal replies are preferred.",
      "predicates": [
        "mated",
        "capture",
        "check_with_one_reply",
        "check_with_two_replies",
        "check",
        "save_piece",
        "king_move",
        "legal_move"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_WHEN_UP_MATERIAL",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Replies while we are up material",
      "description": "When the opponent is down the material objective, consider only mate, recapture, and checks ordered by one reply, two replies, then other checks. A check is followed for exactly one answering move.",
      "predicates": [
        "mated",
        "recapture",
        "check_with_one_reply",
        "check_with_two_replies",
        "check"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "SEARCH_REPLIES_TO_ATTACKED_PIECE",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Replies to an attacked piece",
      "description": "Consider ordinary ways to answer an attack: capture the attacker, move or defend the piece, block the attack, give a forcing check, or make a capture.",
      "predicates": [
        "mated",
        "capture_attacker",
        "move_attacked_piece",
        "defend_attacked_piece",
        "block_attack",
        "check_with_one_reply",
        "check_with_two_replies",
        "check",
        "capture"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "SEARCH_REPLIES_TO_SKEWER",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Replies to a skewer",
      "description": "Consider ordinary ways to answer a skewer: capture the skewering piece, move or defend the skewered piece, block the line, give a forcing check, or make a capture.",
      "predicates": [
        "mated",
        "capture_attacker",
        "move_skewered_piece",
        "defend_skewered_piece",
        "block_skewer",
        "check_with_one_reply",
        "check_with_two_replies",
        "check",
        "capture"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "SEARCH_REPLIES_TO_ATTACKED_DEFENDER",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Replies while a defender is attacked",
      "description": "A non-pawn piece is attacked and has exactly one effective defender; our last move safely attacked that defender. Retain only a move that puts the defender on a safe square while it still defends the loose piece, a capture that does the same, or a direct capture of the attacking piece.",
      "predicates": [
        "mated",
        "move_defender_while_still_defending_loose_piece",
        "capture_and_keep_defending_loose_piece",
        "capture_attacker"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "LINE_PROVED",
      "routine": "main",
      "kind": "inspect",
      "label": "Propagate proof",
      "terminal_checks": false,
      "description": "One successful candidate proves a choice frame. Every retained opponent reply must be discharged before a replies frame is proved.",
      "rules": [
        {
          "label": "a chosen move worked; discard its unused alternatives",
          "when": {
            "frame": "choice"
          },
          "to": "DISCARD_CHOICE_FRAME"
        },
        {
          "label": "one opponent reply is discharged; examine the next",
          "when": {
            "frame": "replies"
          },
          "to": "POP_POSITION"
        },
        {
          "label": "the root position is proved",
          "when": {
            "frame": "root"
          },
          "to": "SOLVED"
        }
      ],
      "on": {
        "depth": "EXHAUSTED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "LINE_FAILED",
      "routine": "main",
      "kind": "inspect",
      "label": "Propagate failure",
      "terminal_checks": false,
      "description": "A failed candidate falls through to the next candidate. A failed opponent reply refutes the parent choice.",
      "rules": [
        {
          "label": "this candidate failed; try the next candidate",
          "when": {
            "frame": "choice"
          },
          "to": "POP_POSITION"
        },
        {
          "label": "an opponent reply refuted this candidate",
          "when": {
            "frame": "replies"
          },
          "to": "DISCARD_REPLY_FRAME"
        },
        {
          "label": "the root position is not solved by this policy",
          "when": {
            "frame": "root"
          },
          "to": "EXHAUSTED"
        }
      ],
      "on": {
        "depth": "EXHAUSTED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "DISCARD_CHOICE_FRAME",
      "routine": "main",
      "kind": "pop",
      "until": "current_frame",
      "label": "Commit successful choice",
      "description": "Discard unused sibling moves until the choice delimiter, restore the ancestor, and propagate proof.",
      "on": {
        "delimiter": "LINE_PROVED",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "DISCARD_REPLY_FRAME",
      "routine": "main",
      "kind": "pop",
      "until": "current_frame",
      "label": "Abort refuted replies",
      "description": "Discard the remaining sibling replies until the replies delimiter, restore the ancestor, and propagate failure.",
      "on": {
        "delimiter": "LINE_FAILED",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "SOLVED",
      "routine": "main",
      "kind": "accept",
      "label": "Solved",
      "description": "A root move worked against every retained opponent reply."
    },
    {
      "id": "EXHAUSTED",
      "routine": "main",
      "kind": "reject",
      "label": "Failed loudly",
      "description": "Every candidate failed, or this basic policy could not narrow a required reply set."
    }
  ],
  "oracle": {
    "reply_limit": 2,
    "reply_class_limit": 2,
    "objective_gain": 2,
    "max_positions": 12000,
    "attack_min_value": 3,
    "mate_threat_limit": 1
  }
}
