{
  "schema": "predicate-policy/v2",
  "name": "basic",
  "version": "3.0.0",
  "goal": "gain_at_least_exchange",
  "entry": "START",
  "outcomes": {
    "accept_state": "SOLVED",
    "reject_state": "EXHAUSTED",
    "winning_predicates": [
      "pda_complete"
    ],
    "failure_predicates": []
  },
  "budgets": {
    "thoughts": 1600,
    "depth": 48,
    "call_depth": 0
  },
  "routines": [
    {
      "id": "main",
      "label": "Basic delimiter-stack DFA",
      "entry": "START"
    }
  ],
  "states": [
    {
      "id": "START",
      "routine": "main",
      "kind": "push_initial",
      "label": "Start",
      "description": "Push the root board position.",
      "on": {
        "pushed": "POP_POSITION",
        "invalid": "EXHAUSTED"
      }
    },
    {
      "id": "POP_POSITION",
      "routine": "main",
      "kind": "pop",
      "label": "Pop next position",
      "description": "Pop the highest-priority retained board position. When a frame delimiter is reached, restore its ancestor and follow the delimiter's DFA transition.",
      "on": {
        "thought": "INSPECT_POSITION",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "INSPECT_POSITION",
      "routine": "main",
      "kind": "inspect",
      "label": "Inspect board position",
      "terminal_checks": false,
      "description": "Read the oracle predicates and choose one visible DFA state. Delimiters are stack scope only; every tree node remains a real board position.",
      "rules": [
        {
          "label": "this line is proved",
          "when": {
            "any": [
              "mate",
              "branch_proved",
              "objective_won",
              "gain_at_least_exchange_locked",
              "gain_greater_than_exchange_locked"
            ]
          },
          "to": "LINE_PROVED"
        },
        {
          "label": "this line is refuted or unexplorable",
          "when": {
            "any": [
              "mated",
              "stalemate",
              "objective_refutation",
              "objective_refuted",
              "unexplorable",
              "oracle_limit"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "our move: scan one ordered predicate list",
          "when": {
            "side": "my"
          },
          "to": "SEARCH_OUR_MOVE"
        },
        {
          "label": "opponent replies fit the exhaustive budget",
          "when": {
            "side": "their",
            "any": [
              "replies_within_budget"
            ]
          },
          "to": "SEARCH_EXHAUSTIVE_REPLIES"
        },
        {
          "label": "opponent replies have certified reply classes",
          "when": {
            "side": "their",
            "any": [
              "reply_classes_certified"
            ]
          },
          "to": "SEARCH_REPLY_CLASSES"
        },
        {
          "label": "opponent replies cannot be handled by this policy",
          "when": {
            "side": "their"
          },
          "to": "LINE_FAILED"
        }
      ],
      "on": {
        "depth": "LINE_FAILED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "SEARCH_OUR_MOVE",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "label": "Our move",
      "description": "One card. Check every predicate in order, retain every matching legal move once, push one choice-frame delimiter, push all retained moves, then pop the highest-priority move.",
      "predicates": [
        "mate",
        "move_middle_with_check",
        "capture_back_of_alignment",
        "recapture",
        "mate_in_1",
        "check",
        "capture",
        "attack"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "choice",
        "on_empty": "LINE_FAILED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_EXHAUSTIVE_REPLIES",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Exhaustive replies within budget",
      "description": "The complete legal reply set is small enough to enumerate. Use ordinary chess predicates only, with required_reply as the catch-all, and push every reply in one replies frame.",
      "predicates": [
        "mated",
        "capture",
        "mate_in_1",
        "check",
        "king_move",
        "required_reply"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_REPLY_CLASSES",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Certified opponent reply classes",
      "description": "The legal reply set is too large to enumerate. Push every oracle-certified refutation, recapture, or objective-repairing class member in one replies frame.",
      "predicates": [
        "mated",
        "objective_refutation",
        "recapture",
        "repairs_objective",
        "reply_relevant"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "LINE_PROVED",
      "routine": "main",
      "kind": "inspect",
      "label": "Propagate proof",
      "terminal_checks": false,
      "description": "A choice succeeds by one proved child; a replies frame succeeds only after every retained reply has been discharged.",
      "rules": [
        {
          "label": "a chosen move worked; discard its unused alternatives",
          "when": {
            "frame": "choice"
          },
          "to": "DISCARD_CHOICE_FRAME"
        },
        {
          "label": "one required reply is discharged; examine the next reply",
          "when": {
            "frame": "replies"
          },
          "to": "POP_POSITION"
        },
        {
          "label": "the root position is proved",
          "when": {
            "frame": "root"
          },
          "to": "SOLVED"
        }
      ],
      "on": {
        "depth": "EXHAUSTED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "LINE_FAILED",
      "routine": "main",
      "kind": "inspect",
      "label": "Propagate failure",
      "terminal_checks": false,
      "description": "A failed choice falls through to its next candidate. One failed required reply refutes its parent choice and discards the rest of that reply frame.",
      "rules": [
        {
          "label": "this candidate failed; try the next candidate",
          "when": {
            "frame": "choice"
          },
          "to": "POP_POSITION"
        },
        {
          "label": "a required reply failed; discard the rest of its reply frame",
          "when": {
            "frame": "replies"
          },
          "to": "DISCARD_REPLY_FRAME"
        },
        {
          "label": "the root position is not solved by this policy",
          "when": {
            "frame": "root"
          },
          "to": "EXHAUSTED"
        }
      ],
      "on": {
        "depth": "EXHAUSTED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "DISCARD_CHOICE_FRAME",
      "routine": "main",
      "kind": "pop",
      "until": "current_frame",
      "label": "Commit successful choice",
      "description": "Silently pop unused sibling positions until this choice-frame delimiter, then restore the ancestor and propagate proof.",
      "on": {
        "delimiter": "LINE_PROVED",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "DISCARD_REPLY_FRAME",
      "routine": "main",
      "kind": "pop",
      "until": "current_frame",
      "label": "Abort refuted reply frame",
      "description": "Silently pop the remaining sibling replies until this replies-frame delimiter, then restore the ancestor and propagate failure.",
      "on": {
        "delimiter": "LINE_FAILED",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "SOLVED",
      "routine": "main",
      "kind": "accept",
      "label": "Solved",
      "description": "A root choice succeeded and every required opponent reply in its nested delimiter frames was discharged."
    },
    {
      "id": "EXHAUSTED",
      "routine": "main",
      "kind": "reject",
      "label": "Failed loudly",
      "description": "Every candidate failed, or a required line was refuted, unexplorable, missing, or over budget."
    }
  ],
  "oracle": {
    "reply_limit": 2,
    "reply_class_limit": 8,
    "objective_gain": 2,
    "objective_probe_depth": 3,
    "objective_probe_limit": 96,
    "max_positions": 12000,
    "mate_probe": true,
    "mate_probe_limit": 96,
    "attack_min_value": 3
  }
}
