{
  "schema": "predicate-policy/v2",
  "name": "basic",
  "version": "5.0.0",
  "goal": "gain_at_least_exchange",
  "test_file": "/reasoning/basicpolicy.test",
  "entry": "START",
  "outcomes": {
    "accept_state": "SOLVED",
    "reject_state": "EXHAUSTED",
    "winning_predicates": [
      "mate"
    ],
    "failure_predicates": []
  },
  "budgets": {
    "thoughts": 1600,
    "depth": 48,
    "call_depth": 0
  },
  "routines": [
    {
      "id": "main",
      "label": "Basic human chess DFA",
      "entry": "START"
    }
  ],
  "states": [
    {
      "id": "START",
      "routine": "main",
      "kind": "push_initial",
      "label": "Start",
      "description": "Push the root board position.",
      "on": {
        "pushed": "POP_POSITION",
        "invalid": "EXHAUSTED"
      }
    },
    {
      "id": "POP_POSITION",
      "routine": "main",
      "kind": "pop",
      "label": "Pop next position",
      "description": "Pop the highest-priority retained board position. A delimiter marks where the current batch ends.",
      "on": {
        "thought": "INSPECT_POSITION",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "INSPECT_POSITION",
      "routine": "main",
      "kind": "inspect",
      "label": "Inspect position",
      "terminal_checks": false,
      "description": "Choose the next card from ordinary chess facts visible in the current position.",
      "rules": [
        {
          "label": "we gave mate",
          "when": {
            "any": [
              "mate"
            ]
          },
          "to": "LINE_PROVED"
        },
        {
          "label": "we are mated, stalemated, or there are too many replies for this basic policy",
          "when": {
            "any": [
              "mated",
              "stalemate",
              "more_than_two_relevant_replies",
              "more_than_two_legal_replies"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "we answered a check and remain up the material objective",
          "when": {
            "all": [
              "check_response",
              "up_material"
            ]
          },
          "to": "LINE_PROVED"
        },
        {
          "label": "the two-ply check extension ended without preserving the material objective",
          "when": {
            "any": [
              "check_response"
            ]
          },
          "to": "LINE_FAILED"
        },
        {
          "label": "our king is in check",
          "when": {
            "side": "my",
            "any": [
              "in_check"
            ]
          },
          "to": "SEARCH_CHECK_RESPONSES"
        },
        {
          "label": "our move",
          "when": {
            "side": "my"
          },
          "to": "SEARCH_OUR_MOVE"
        },
        {
          "label": "we are up the material objective",
          "when": {
            "side": "their",
            "any": [
              "up_material"
            ]
          },
          "to": "SEARCH_WHEN_UP_MATERIAL"
        },
        {
          "label": "the opponent has two or fewer legal moves",
          "when": {
            "side": "their",
            "any": [
              "two_or_fewer_legal_moves"
            ]
          },
          "to": "SEARCH_ALL_REPLIES"
        },
        {
          "label": "the current position contains a skewer",
          "when": {
            "side": "their",
            "any": [
              "skewer"
            ]
          },
          "to": "SEARCH_REPLIES_TO_SKEWER"
        },
        {
          "label": "the current position contains an attacked or loose piece",
          "when": {
            "side": "their",
            "any": [
              "attacked_piece",
              "loose_piece"
            ]
          },
          "to": "SEARCH_REPLIES_TO_ATTACKED_PIECE"
        },
        {
          "label": "this basic policy cannot narrow the opponent's replies",
          "when": {
            "side": "their"
          },
          "to": "LINE_FAILED"
        }
      ],
      "on": {
        "depth": "LINE_FAILED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "SEARCH_OUR_MOVE",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "label": "Our move",
      "description": "Scan one human chess list in order and push every matching legal move. The first matching predicate supplies the move's priority.",
      "predicates": [
        "mate",
        "move_middle_with_check",
        "capture_back_of_alignment",
        "recapture",
        "capture_loose_non_pawn_piece",
        "remove_sole_defender",
        "check_and_attack_piece",
        "skewer",
        "check",
        "capture",
        "add_attacker_to_loose_non_pawn_piece",
        "add_attacker_to_pinned_piece"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "choice",
        "on_empty": "LINE_FAILED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_CHECK_RESPONSES",
      "routine": "main",
      "kind": "search",
      "side": "my",
      "label": "Answer the check",
      "description": "A check earns a two-ply extension: the checking move and one answer. Prefer mate, recapture, capture, another check, then any legal king response. After the answer, stop and ask whether the material objective survived.",
      "predicates": [
        "mate",
        "recapture",
        "capture",
        "check",
        "king_move",
        "legal_move"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "choice",
        "on_empty": "LINE_FAILED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_ALL_REPLIES",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "All replies",
      "description": "The opponent has at most two legal moves, so examine both. Captures, checks, and moves that save an attacked piece are ordered first.",
      "predicates": [
        "mated",
        "capture",
        "check",
        "save_piece",
        "king_move",
        "legal_move"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_FAILED"
      }
    },
    {
      "id": "SEARCH_WHEN_UP_MATERIAL",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Replies while we are up material",
      "description": "When the opponent is down the material objective, consider only mate, recapture, and check. A check is followed for exactly one answering move, completing a two-ply check extension.",
      "predicates": [
        "mated",
        "recapture",
        "check"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "SEARCH_REPLIES_TO_ATTACKED_PIECE",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Replies to an attacked piece",
      "description": "Consider ordinary ways to answer an attack: capture the attacker, move or defend the piece, block the attack, give check, or make a capture.",
      "predicates": [
        "mated",
        "capture_attacker",
        "move_attacked_piece",
        "defend_attacked_piece",
        "block_attack",
        "check",
        "capture"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "SEARCH_REPLIES_TO_SKEWER",
      "routine": "main",
      "kind": "search",
      "side": "their",
      "label": "Replies to a skewer",
      "description": "Consider ordinary ways to answer a skewer: capture the skewering piece, move or defend the skewered piece, block the line, give check, or make a capture.",
      "predicates": [
        "mated",
        "capture_attacker",
        "move_skewered_piece",
        "defend_skewered_piece",
        "block_skewer",
        "check",
        "capture"
      ],
      "closure": {
        "mode": "all"
      },
      "frame": {
        "kind": "replies",
        "on_empty": "LINE_PROVED"
      },
      "on": {
        "pushed": "POP_POSITION",
        "none": "LINE_PROVED"
      }
    },
    {
      "id": "LINE_PROVED",
      "routine": "main",
      "kind": "inspect",
      "label": "Propagate proof",
      "terminal_checks": false,
      "description": "One successful candidate proves a choice frame. Every retained opponent reply must be discharged before a replies frame is proved.",
      "rules": [
        {
          "label": "a chosen move worked; discard its unused alternatives",
          "when": {
            "frame": "choice"
          },
          "to": "DISCARD_CHOICE_FRAME"
        },
        {
          "label": "one opponent reply is discharged; examine the next",
          "when": {
            "frame": "replies"
          },
          "to": "POP_POSITION"
        },
        {
          "label": "the root position is proved",
          "when": {
            "frame": "root"
          },
          "to": "SOLVED"
        }
      ],
      "on": {
        "depth": "EXHAUSTED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "LINE_FAILED",
      "routine": "main",
      "kind": "inspect",
      "label": "Propagate failure",
      "terminal_checks": false,
      "description": "A failed candidate falls through to the next candidate. A failed opponent reply refutes the parent choice.",
      "rules": [
        {
          "label": "this candidate failed; try the next candidate",
          "when": {
            "frame": "choice"
          },
          "to": "POP_POSITION"
        },
        {
          "label": "an opponent reply refuted this candidate",
          "when": {
            "frame": "replies"
          },
          "to": "DISCARD_REPLY_FRAME"
        },
        {
          "label": "the root position is not solved by this policy",
          "when": {
            "frame": "root"
          },
          "to": "EXHAUSTED"
        }
      ],
      "on": {
        "depth": "EXHAUSTED",
        "missing": "EXHAUSTED"
      },
      "default": "EXHAUSTED"
    },
    {
      "id": "DISCARD_CHOICE_FRAME",
      "routine": "main",
      "kind": "pop",
      "until": "current_frame",
      "label": "Commit successful choice",
      "description": "Discard unused sibling moves until the choice delimiter, restore the ancestor, and propagate proof.",
      "on": {
        "delimiter": "LINE_PROVED",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "DISCARD_REPLY_FRAME",
      "routine": "main",
      "kind": "pop",
      "until": "current_frame",
      "label": "Abort refuted replies",
      "description": "Discard the remaining sibling replies until the replies delimiter, restore the ancestor, and propagate failure.",
      "on": {
        "delimiter": "LINE_FAILED",
        "empty": "EXHAUSTED"
      }
    },
    {
      "id": "SOLVED",
      "routine": "main",
      "kind": "accept",
      "label": "Solved",
      "description": "A root move worked against every retained opponent reply."
    },
    {
      "id": "EXHAUSTED",
      "routine": "main",
      "kind": "reject",
      "label": "Failed loudly",
      "description": "Every candidate failed, or this basic policy could not narrow a required reply set."
    }
  ],
  "oracle": {
    "reply_limit": 2,
    "reply_class_limit": 2,
    "objective_gain": 2,
    "max_positions": 12000,
    "attack_min_value": 3
  }
}
